# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000


CLIENT_ORIGIN=http://localhost:5173

RESEND_API_KEY:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where messages are delivered, and the "from" address shown on them.
CONTACT_TO_EMAIL=Your_Email1@gmail.com
CONTACT_FROM_EMAIL=
