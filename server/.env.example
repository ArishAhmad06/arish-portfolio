# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Browser origin allowed to call the API in development (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# --- Contact form email (SMTP) ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "App Password", not your normal password>.
# If any of these are empty, the contact form returns a clear "not configured" error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where messages are delivered, and the "from" address shown on them.
CONTACT_TO_EMAIL=ahmad.aris0987@gmail.com
CONTACT_FROM_EMAIL=
